# Streamlit Cloud Secrets Configuration Template
# For Streamlit Cloud: paste these into App Settings -> Secrets
# For Local Testing: copy this file to .streamlit/secrets.toml and fill in values

DB_HOST = "your-mysql-instance.aivencloud.com"
DB_PORT = "3306"
DB_USER = "avnadmin"
DB_PASSWORD = "your-database-password"
DB_NAME = "defaultdb"
DB_SSL = "true"
